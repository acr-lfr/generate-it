{
  "name": "generate-it",
  "version": "5.63.0",
  "description": "Generate-it, will generate servers, clients, web-socket and anything else you can template with nunjucks from yml files (openapi/asyncapi)",
  "author": "Acrontum GmbH & Liffery Ltd",
  "license": "MIT",
  "bin": {
    "generate-it": "./build/cli.js"
  },
  "types": "build/index.d.ts",
  "scripts": {
    "install:githooks": "cp ./githooks/* .git/hooks",
    "build:tocs": "npx doctoc .",
    "build": "rm -fR ./build && tsc -p . && tsc-alias",
    "build:watch": "ttsc --watch -p .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test",
    "start": "node cli.js",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "npm run build && jest --runInBand",
    "test:unit:single": "jest --runInBand --collectCoverage=false"
  },
  "homepage": "https://acr-lfr.github.io/generate-it",
  "repository": {
    "type": "git",
    "url": "https://github.com/acr-lfr/generate-it"
  },
  "keywords": [
    "asyncapi",
    "swagger",
    "openapi",
    "codegen",
    "generator",
    "generate-it"
  ],
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^14.2.1",
    "@colors/colors": "1.6.0",
    "@root/walk": "^1.1.0",
    "commander": "^14.0.3",
    "compare-versions": "^6.1.1",
    "deepmerge": "^4.2.2",
    "fs-extra": "^11.3.6",
    "generate-it-mockers": "^1.1.1",
    "inquirer": "^8.2.6",
    "js-yaml": "^4.3.0",
    "lodash": "^4.17.21",
    "npm-tool-version-check": "^1.2.0",
    "nunjucks": "^3.2.4",
    "prettier": "^2.4.1",
    "quicktype-core": "^25.0.0",
    "text-file-diff": "^1.4.8",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "generate-it-mockers": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^8.2.13",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.43",
    "@types/nunjucks": "^3.2.3",
    "@types/picomatch": "^4.0.3",
    "@types/prettier": "^2.7.3",
    "@types/swagger-schema-official": "^2.0.25",
    "@types/yamljs": "^0.2.34",
    "eslint": "^10.7.0",
    "fdir": "^6.5.0",
    "hasha": "^5.2.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.9.1",
    "typescript-eslint": "^8.64.0"
  }
}
